---
import { getCollection } from "astro:content";
import { getRelativeLocaleUrl } from "astro:i18n";
import { Image } from "astro:assets";
import IconRss from "@/assets/icons/IconRss.svg";
import IconArrowRight from "@/assets/icons/IconArrowRight.svg";
import avatar from "@/assets/images/Carlos.png";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import Socials from "@/components/Socials.astro";
import Card from "@/components/Card.astro";
import MicroEntry from "@/components/MicroEntry.astro";
import LinkButton from "@/components/LinkButton.astro";
import { getSortedPosts } from "@/utils/getSortedPosts";
import { getSortedEntries } from "@/utils/getSortedEntries";
import { useTranslations } from "@/i18n";
import config from "@/config";

const { site, socials, posts: postsConfig } = config;

const locale = Astro.currentLocale ?? config.site.lang;
const t = useTranslations(locale);

const posts = getSortedPosts(await getCollection("posts"));
const notes = getSortedPosts(await getCollection("notes"));
const micro = await getSortedEntries("micro");

const sections = [
  {
    id: "recent-posts",
    title: t.home.recentPosts,
    entries: posts.slice(0, postsConfig.perIndex),
    section: "posts" as const,
    more: t.home.allPosts,
  },
  {
    id: "recent-notes",
    title: t.home.recentNotes,
    entries: notes.slice(0, postsConfig.perIndex),
    section: "notes" as const,
    more: t.home.allNotes,
  },
];
const homePath = getRelativeLocaleUrl(locale, "");
---

<Layout>
  <Header />
  <main
    id="main-content"
    data-layout="index"
    data-home-path={homePath}
    class="app-layout my-1"
  >
    <section
      id="hero"
      class="border-border flex flex-col gap-6 border-b pt-8 pb-6 sm:flex-row sm:items-center"
    >
      <Image
        src={avatar}
        alt={site.author}
        width={144}
        height={144}
        class="border-border size-28 shrink-0 rounded-full border-2 object-cover sm:size-36"
        loading="eager"
      />
      <div>
        <h1 class="inline-block text-3xl font-bold sm:text-4xl">
          {site.author}
        </h1>
        <a
          target="_blank"
          href={`${import.meta.env.BASE_URL.replace(/\/?$/, "/")}rss.xml`}
          class="ms-2 inline-block"
          aria-label="RSS Feed"
          title="RSS Feed"
        >
          <IconRss
            width={20}
            height={20}
            class="stroke-accent scale-125 stroke-3 rtl:-rotate-90"
          />
          <span class="sr-only">RSS Feed</span>
        </a>
        <p class="mt-2">{site.description}</p>
        {
          socials.length > 0 && (
            <div class="mt-3 -ms-1">
              <Socials />
            </div>
          )
        }
      </div>
    </section>

    {
      sections.map(({ id, title, entries, section, more }) =>
        entries.length > 0 ? (
          <section {id} class="border-border border-b pt-12 pb-6">
            <h2 class="text-2xl font-semibold tracking-wide">{title}</h2>
            <ul>
              {entries.map(data => (
                <Card variant="h3" {section} {...data} />
              ))}
            </ul>
            <LinkButton href={getRelativeLocaleUrl(locale, section)}>
              {more}
              <IconArrowRight class="inline-block rtl:-rotate-180" />
            </LinkButton>
          </section>
        ) : null
      )
    }

    {
      micro.length > 0 && (
        <section id="recent-micro" class="pt-12 pb-6">
          <h2 class="text-2xl font-semibold tracking-wide">
            {t.home.recentMicro}
          </h2>
          <ul>
            {micro.slice(0, 5).map(entry => (
              <MicroEntry {entry} />
            ))}
          </ul>
          <div class="my-8 text-center">
            <LinkButton href={getRelativeLocaleUrl(locale, "micro")}>
              {t.home.allMicro}
              <IconArrowRight class="inline-block rtl:-rotate-180" />
            </LinkButton>
          </div>
        </section>
      )
    }
  </main>
  <Footer />
</Layout>

<script>
  document.addEventListener("astro:page-load", () => {
    const indexLayout = (document.querySelector("#main-content") as HTMLElement)
      ?.dataset;
    const baseRoot = import.meta.env.BASE_URL.replace(/\/?$/, "/");
    if (indexLayout?.layout) {
      sessionStorage.setItem("backUrl", indexLayout.homePath ?? baseRoot);
    }
  });
</script>
