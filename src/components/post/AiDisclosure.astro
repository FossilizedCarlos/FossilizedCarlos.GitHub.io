---
import IconClaude from "@/assets/icons/ai/claude.svg";
import IconOpenAI from "@/assets/icons/ai/openai.svg";
import IconGitHubCopilot from "@/assets/icons/ai/github-copilot.svg";
import IconMicrosoftCopilot from "@/assets/icons/ai/microsoft-copilot.svg";
import IconHermes from "@/assets/icons/ai/hermes.svg";
import IconOpenClaw from "@/assets/icons/ai/openclaw.svg";
import IconOllama from "@/assets/icons/ai/ollama.svg";
import IconLlamaCpp from "@/assets/icons/ai/llama-cpp.svg";
import IconMiniMax from "@/assets/icons/ai/minimax.svg";
import IconRobot from "@/assets/icons/ai/robot.svg";

/**
 * Shows which harness and model generated a post. `author` follows the
 * "<harness> using <model>" pattern, e.g. "Claude Code using Claude Opus 5.5".
 */
type Props = {
  author: string;
  class?: string;
};

const { author, class: className } = Astro.props;

// First match wins, so list the more specific names first.
const ICONS = [
  { test: /microsoft copilot/i, Icon: IconMicrosoftCopilot },
  { test: /copilot/i, Icon: IconGitHubCopilot },
  { test: /claude|opus|sonnet|haiku|fable/i, Icon: IconClaude },
  { test: /openai|chatgpt|codex|gpt/i, Icon: IconOpenAI },
  { test: /hermes/i, Icon: IconHermes },
  { test: /openclaw|clawdbot|moltbot/i, Icon: IconOpenClaw },
  { test: /ollama/i, Icon: IconOllama },
  { test: /llama[.\s-]?cpp|llama-swap/i, Icon: IconLlamaCpp },
  { test: /minimax/i, Icon: IconMiniMax },
];

// These icons keep their own colors; the rest follow the text color.
const MULTICOLOR = new Set([
  IconMicrosoftCopilot,
  IconOpenClaw,
  IconMiniMax,
]);

const iconFor = (name: string) =>
  ICONS.find(({ test }) => test.test(name))?.Icon ?? IconRobot;

const [harness, model] = author.split(/\s+using\s+/i, 2).map(s => s.trim());
const parts = [harness, model].filter(Boolean).map(name => {
  const Icon = iconFor(name);
  // Passing `fill={undefined}` would drop an icon's own root fill.
  const fill = MULTICOLOR.has(Icon) ? {} : { fill: "currentColor" };
  return { name, Icon, fill };
});
---

<aside
  aria-label="AI disclosure"
  class:list={[
    "border-border bg-muted/40 text-foreground not-prose @container rounded-sm border px-3 py-2 sm:px-4 sm:py-3",
    className,
  ]}
>
  {/* Text shrinks with the frame width to stay on one line; very long names still wrap. */}
  <div
    class="flex flex-wrap items-center gap-x-[0.4em] gap-y-1 text-[clamp(0.5rem,3.6cqi,1.3125rem)] whitespace-nowrap"
  >
    <span class="font-semibold">Generated by</span>
    {
      parts.map(({ name, Icon, fill }, index) => (
        <>
          {index > 0 && <span>using</span>}
          <span class="inline-flex items-center gap-[0.3em]">
            <Icon
              class="size-[1.15em] shrink-0"
              {...fill}
              aria-hidden="true"
              width={24}
              height={24}
            />
            <span class="font-mono">{name}</span>
          </span>
        </>
      ))
    }
  </div>
</aside>
